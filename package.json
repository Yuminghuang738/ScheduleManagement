{
  "name": "chrono-flow",
  "version": "1.0.0",
  "description": "智能日程管理桌面应用 — 把零散的日程信息变成一张自动整理好的智能日程表",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:mobile": "vite --config vite.mobile.config.ts",
    "build": "npm run typecheck && electron-vite build",
    "build:mobile": "vite build --config vite.mobile.config.ts",
    "preview": "electron-vite preview",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.vue --fix",
    "build:win": "electron-vite build && electron-builder --win",
    "build:linux": "electron-vite build && electron-builder --linux",
    "cap:add:android": "cap add android",
    "cap:add:ios": "cap add ios",
    "cap:sync": "npm run build:mobile && cap sync"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/ios": "^6.0.0",
    "@ctrl/tinycolor": "^4.2.1",
    "element-plus": "^2.10.0",
    "pinia": "^3.0.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "@electron-toolkit/preload": "^3.0.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@rushstack/eslint-patch": "^1.10.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/eslint-config-typescript": "^14.0.0",
    "@vue/tsconfig": "^0.7.0",
    "electron": "^35.0.0",
    "electron-builder": "^25.0.0",
    "electron-vite": "^3.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^9.32.0",
    "typescript": "^5.7.0",
    "vite": "^6.2.0",
    "vue-tsc": "^2.2.0"
  }
}
